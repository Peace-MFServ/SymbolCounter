# Copy to .env on the server and fill in. Never commit .env.

# Public address of the server. With no domain, use the VM's IP plus .nip.io,
# e.g. 34.12.34.56.nip.io  (Caddy gets a free HTTPS certificate for it)
SITE_ADDRESS=

# Long random string used to sign logins. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Word people must type to create an account on this server. Leave empty to allow anyone.
REGISTER_CODE=

# Cin7 Core API, so Products can sync straight from Cin7 instead of the Excel
# export. Cin7 > Integrations > API > add an application; copy both values here.
CIN7_ACCOUNT_ID=
CIN7_APP_KEY=
