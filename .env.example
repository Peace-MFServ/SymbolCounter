# Copy to .env on the server and fill in. Never commit .env.

# Public address of the server. With no domain, use the VM's IP plus .nip.io,
# e.g. 34.12.34.56.nip.io  (Caddy gets a free HTTPS certificate for it)
SITE_ADDRESS=

# Long random string used to sign logins. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Word the team must type to create an account. Always set it on the server:
# empty means anyone who finds the site can make an account and see every job.
REGISTER_CODE=

# Hours the team has from an architect sending plans in (the clock on Incoming).
TURNAROUND_HOURS=48

# Cin7 Core API, so Products can sync straight from Cin7 instead of the Excel
# export. Cin7 > Integrations > API > add an application; copy both values here.
CIN7_ACCOUNT_ID=
CIN7_APP_KEY=
